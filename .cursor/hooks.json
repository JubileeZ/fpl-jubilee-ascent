{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/run-hook.cmd commit-verify",
        "matcher": "git\\s+commit",
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/run-hook.cmd stop-checkpoint",
        "loop_limit": 3
      }
    ],
    "preCompact": [
      {
        "command": ".cursor/hooks/run-hook.cmd pre-compact"
      }
    ]
  }
}
